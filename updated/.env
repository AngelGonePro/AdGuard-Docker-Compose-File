# AdGuard Home container settings
ADGUARD_IMAGE=adguard/adguardhome:latest

# Resource ceiling (raised from 256M: blocklist loading alone used ~210MiB)
ADGUARD_CPU_LIMIT=0.75
ADGUARD_MEM_LIMIT=384M
ADGUARD_MEM_RESERVATION=64M

# Host-side ports
ADGUARD_DNS_PORT=53
ADGUARD_WEB_PORT=8800

# Bind-mount paths
ADGUARD_WORKDIR=./workdir
ADGUARD_CONFDIR=./confdir
